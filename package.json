{
  "name": "flappy-roadster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tributo no oficial al Tesla Roadster 2026: un flappy con propulsores de nitrógeno, hecho con Three.js.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/express": "^5.0.6",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
