# Postgres (App Platform lo rellena solo). Si está vacío se usa SQLite local.
DATABASE_URL=
# Ruta del archivo SQLite del servidor (por defecto ./data/scores.db)
DATABASE_PATH=
# Certificado CA de la base gestionada (App Platform lo inyecta desde ${db.CA_CERT})
DATABASE_CA_CERT=
